  <text>
    <body>
      <termEntry id="tid-001">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of supplying electrical energy to a battery or an electric vehicle.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-002">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>observatory</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An institution that monitors and analyzes data in a specific field, such as alternative fuels.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>обсерватория</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-003">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>infrastructure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The basic physical and organizational structures and facilities needed for the operation of a system.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>инфраструктура</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-004">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging station</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A stationary device designed to recharge the traction batteries of electric vehicles.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядная станция</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-005">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>key performance indicator</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A quantitative metric used to evaluate the performance or success of a process or system.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>показатель эффективности</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-006">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>target value</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A specified quantitative value that must be achieved as a result of a policy or project.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>целевое значение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-007">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging network</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An interconnected system of charging stations and points managed by operators.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядная сеть</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-008">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>standard</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A normative document that establishes requirements for products, processes, or services.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>стандарт</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-009">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>term</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A word or phrase used to designate a strictly defined concept in a particular field of knowledge.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>термин</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-010">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>alternating current</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An electric current whose direction and magnitude periodically reverse over time.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>переменный ток</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-011">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>direct current</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An electric current that flows in one direction only and does not change its direction over time.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>постоянный ток</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-012">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>power</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A physical quantity characterizing the rate of transfer or conversion of electrical energy.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>мощность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-013">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging capacity</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The maximum level of power or energy that a charger can deliver to an electric vehicle.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядная способность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-014">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>connector</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An electrical connector providing mechanical and electrical connection between a charging station and a vehicle.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>разъем</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-015">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>interoperability</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The ability of different systems and devices to exchange data and operate together without user intervention.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>интероперабельность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-016">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>carmaker</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A company engaged in the design and manufacture of automobiles.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>автопроизводитель</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-017">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>consolidation</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of combining separate technological solutions or market participants into a single stable system.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>консолидация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-018">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>megawatt charging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An ultra-fast charging technology with a capacity above 1 MW for heavy-duty transport.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>мегаваттная зарядка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-019">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging power</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The amount of electrical power delivered by a charger to a battery.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядная мощность</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-020">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>software</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A set of programs and data that ensures the operation of charging hardware.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>программное обеспечение</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-021">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging standard</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">An agreed set of technical requirements for the charging process and equipment.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>стандарт зарядки</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-022">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>standardization</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The activity of establishing uniform rules and norms to ensure compatibility and quality.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>стандартизация</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-023">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging function</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The purpose or role of charging equipment in a specific operational environment.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>функция зарядки</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-024">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>public charging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Charging available to all electric vehicle drivers without restrictions on the user group.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>общественная зарядка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-025">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>private charging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Charging carried out on private territory for personal use or for fleet needs.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>частная зарядка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-026">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>deployment</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of commissioning and scaling up charging infrastructure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>развертывание</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-027">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>unrestricted access</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The absence of temporal, spatial, or user restrictions on the use of a charging station.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>неограниченный доступ</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-028">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>semi-public charging</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Charging available to a broad audience but located on private territory and subject to restrictions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>полуобщественная зарядка</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-029">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>access restriction</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A condition under which the use of a charging station is possible only for certain categories of users.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>ограничение доступа</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-030">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>charging service</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A service providing access to charging infrastructure and related functions.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>зарядный сервис</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-031">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>navigation service</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A software and hardware complex that provides search and routing to charging stations.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>навигационный сервис</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-032">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>publicly accessible infrastructure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">Charging stations that can be used by all electric vehicle drivers.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>общедоступная инфраструктура</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-033">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>private infrastructure</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A set of charging devices that are privately owned and not available to the general public.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>частная инфраструктура</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-034">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>strategy</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">A long-term action plan aimed at achieving goals in the development of charging infrastructure.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>стратегия</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
        </langSet>
      </termEntry>
      <termEntry id="tid-035">
        <descrip type="subjectField">Автомобилестроение и электротранспорт</descrip>
        <langSet xml:lang="en">
          <tig>
            <term>infrastructure development</term>
            <termNote type="partOfSpeech">noun</termNote>
            <descrip type="definition">The process of quantitative and qualitative growth of the charging network.</descrip>
          </tig>
        </langSet>
        <langSet xml:lang="ru">
          <ntig>
            <termGrp>
              <term>развитие инфраструктуры</term>
              <termNote type="partOfSpeech">noun</termNote>
            </termGrp>
          </ntig>
